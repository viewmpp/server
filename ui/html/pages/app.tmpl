{{define "title"}}MPP Viewer — открыть план MS Project без установки{{end}}

{{define "main"}}
<main class="landing" id="landing">
  <h1>Открыть файл MS&nbsp;Project</h1>
  <p class="lead">
    Перетащите <code>.mpp</code> или <code>.xml</code> сюда — увидите диаграмму Ганта сразу.
    Ничего устанавливать и регистрироваться не нужно.
  </p>

  <div class="drop" id="drop" data-max-upload="{{.MaxUpload}}">
    <input type="file" id="file" accept=".mpp,.xml" hidden>
    <p class="drop__hint">Перетащите файл или <label for="file" class="link">выберите на диске</label></p>
    <p class="drop__note">Файл удаляется сразу после разбора.</p>
  </div>

  <p class="drop__error is-hidden" id="error"></p>
</main>

<div class="app is-hidden" id="app">
  <header class="bar">
    <div class="bar__title">
      <strong>MPP Viewer</strong>
      <span id="project-name" class="muted"></span>
    </div>

    <div class="bar__group">
      <input type="search" id="search" class="search" placeholder="поиск по задачам" autocomplete="off">
    </div>

    <div class="bar__group">
      <span class="label">Масштаб</span>
      <button class="btn btn--scale is-active" data-scale="day">День</button>
      <button class="btn btn--scale" data-scale="week">Неделя</button>
      <button class="btn btn--scale" data-scale="month">Месяц</button>
      <button class="btn btn--scale" data-scale="quarter">Квартал</button>
    </div>

    <div class="bar__group">
      <button class="btn" id="collapse-all">Свернуть всё</button>
      <button class="btn" id="expand-all">Развернуть всё</button>
    </div>

    <div class="bar__group">
      <label class="check"><input type="checkbox" id="toggle-critical" checked> критический путь</label>
      <label class="check"><input type="checkbox" id="toggle-grid" checked> сетка</label>
    </div>

    <div class="bar__group">
      <button class="btn" id="reset">Другой файл</button>
    </div>
  </header>

  <div class="workspace">
    <div id="gantt-here"></div>

    <aside id="details" class="details is-hidden">
      <button class="details__close" id="details-close" aria-label="Закрыть">&times;</button>
      <div id="details-body"></div>
    </aside>
  </div>

  <footer class="statusbar">
    <span id="stats">—</span>
    <span class="legend">
      <i class="sw sw--crit"></i> критическая задача
      <i class="sw sw--off"></i> нерабочий день
    </span>
  </footer>
</div>
{{end}}

{{define "scripts"}}
<script src="/static/js/mapper.js?v={{.Version}}"></script>
<script src="/static/js/app.js?v={{.Version}}"></script>
{{end}}
