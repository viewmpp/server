{{define "html"}}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{.Subject}}</title>
</head>
<body style="margin:0;padding:0;background-color:#f7f7f8;color:#202124;font-family:Arial,Helvetica,sans-serif;-webkit-text-size-adjust:100%;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" bgcolor="#f7f7f8">
    <tr>
      <td align="center" style="padding:40px 16px;">
        <table role="presentation" width="560" cellpadding="0" cellspacing="0" border="0" style="width:100%;max-width:560px;font-family:Arial,Helvetica,sans-serif;">
          <tr><td style="padding:0 0 24px;"><a href="{{.Site}}" style="color:#5e6ad2;font-size:18px;font-weight:700;line-height:24px;text-decoration:none;">View MPP</a></td></tr>
          <tr>
            <td bgcolor="#ffffff" style="padding:28px 24px;border:1px solid #e5e5e8;border-top:3px solid #5e6ad2;border-radius:8px;">
              <h1 style="margin:0 0 16px;color:#202124;font-size:24px;font-weight:600;line-height:32px;letter-spacing:-0.4px;">An account already exists</h1>
              <p style="margin:0 0 24px;color:#41434a;font-size:16px;line-height:26px;">{{.Message}}</p>
              <p style="margin:0;color:#62666d;font-size:14px;line-height:22px;">{{.Hint}}</p>
            </td>
          </tr>
          <tr><td style="padding:20px 25px 0;color:#62666d;font-size:13px;line-height:21px;">Sent by <a href="{{.Site}}" style="color:#5e6ad2;text-decoration:underline;">View MPP</a>. This message is automated; please do not reply.</td></tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>
{{end}}
