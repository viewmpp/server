{{define "html"}}
    <!DOCTYPE html>
    <html lang="en">
    <head>
        <meta charset="UTF-8">
        <title>{{.Subject}}</title>
    </head>
    <body style="font-family: Arial, sans-serif; line-height: 1.5;">

    <h2>{{.Subject}}</h2>
    <p>{{.Message}}</p>
    <p>
        <a href="{{.Link}}"
           style="display:inline-block;padding:10px 16px;background:#3369d6;border-radius:4px;color:#fff;text-decoration:none;">
            Choose a new password
        </a>
    </p>
    <p style="color: #666; font-size: 14px;">{{.Hint}}</p>

    <hr>

    <small style="color:#666;">
        Sent by <a href="{{.Site}}">View MPP</a>. This message is automated - please do not reply.
    </small>
    </body>
    </html>
{{end}}