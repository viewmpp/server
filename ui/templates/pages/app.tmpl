{{define "title"}}
  {{- if .ExampleLabel -}}
    {{.ExampleLabel}} — an MS Project plan in the browser | MPP Viewer
  {{- else -}}
    MPP Viewer — open an MS Project plan without installing anything
  {{- end -}}
{{end}}

{{define "main"}}
<main class="landing centered" id="landing">
  {{with .Flash}}<p class="flash">{{.}}</p>{{end}}

  <h1>Open an MS&nbsp;Project file</h1>
  <p class="lead">
    Drop an <code>.mpp</code> or <code>.xml</code> file here and see the Gantt chart straight away.
    Nothing to install, no signup needed.
  </p>

  <div class="drop" id="drop" data-max-upload="{{.MaxUpload}}">
    <input type="file" id="file" accept=".mpp,.xml" hidden>
    <p class="drop__hint">Drop a file here or <label for="file" class="link">pick one from disk</label></p>
    <p class="drop__note">The file is deleted right after parsing.</p>
  </div>

  <p class="drop__error is-hidden" id="error"></p>

  {{if .Form}}
    <div class="samples">
      <p class="samples__lead">No file at hand? Open one of these:</p>
      <ul class="samples__list">
        {{range .Form}}
          <li>
            <a class="sample" href="/example/{{.Name}}">
              <span class="sample__label">{{.Label}}</span>
              <span class="sample__note">{{.Note}}</span>
            </a>
          </li>
        {{end}}
      </ul>
    </div>
  {{end}}
</main>

<div class="app is-hidden" id="app" data-project-id="{{.ProjectID}}" data-example-name="{{.ExampleName}}" data-file-name="{{.FileName}}">
  <header class="bar">
    <div class="bar__title">
      <span id="project-name" class="muted"></span>
    </div>

    <div class="bar__group">
      <input type="search" id="search" class="search" placeholder="search tasks" autocomplete="off">
    </div>

    <div class="bar__group">
      <span class="label">Scale</span>
      <button class="btn btn--scale is-active" data-scale="day">Day</button>
      <button class="btn btn--scale" data-scale="week">Week</button>
      <button class="btn btn--scale" data-scale="month">Month</button>
      <button class="btn btn--scale" data-scale="quarter">Quarter</button>
    </div>

    <div class="bar__group">
      <button class="btn" id="collapse-all">Collapse all</button>
      <button class="btn" id="expand-all">Expand all</button>
    </div>

    <div class="bar__group">
      <label class="check"><input type="checkbox" id="toggle-critical" checked> critical path</label>
      <label class="check"><input type="checkbox" id="toggle-grid" checked> grid</label>
    </div>

    {{if .IsOwner}}
      <div class="bar__group">
        {{if eq .Access "public"}}
          <form action="/p/{{.ProjectID}}/access" method="POST">
            <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
            <input type="hidden" name="access" value="private">
            <button class="btn" type="submit">Stop sharing</button>
          </form>
          <button class="btn" id="copy-link" data-link="/p/{{.ProjectID}}">Copy link</button>
        {{else if .CanShare}}
          <form action="/p/{{.ProjectID}}/access" method="POST">
            <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
            <input type="hidden" name="access" value="public">
            <button class="btn" type="submit">Share</button>
          </form>
        {{else}}
          <span class="label" title="Sharing is part of the Pro plan">Private</span>
        {{end}}

        <form action="/p/{{.ProjectID}}/delete" method="POST" data-confirm="Delete this project?">
          <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
          <button class="btn btn--danger" type="submit">Delete</button>
        </form>
      </div>
    {{end}}

    <div class="bar__group">
      <button class="btn" id="reset">Another file</button>
    </div>
  </header>

  <div class="summary is-hidden" id="summary"></div>

  <div class="workspace">
    <div id="gantt-here"></div>

    <aside id="details" class="details is-hidden">
      <button class="details__close" id="details-close" aria-label="Close">&times;</button>
      <div id="details-body"></div>
    </aside>
  </div>

  <footer class="statusbar">
    <span id="stats">—</span>
    <span class="legend">
      <i class="sw sw--crit"></i> critical task
      <i class="sw sw--off"></i> non-working day
    </span>
  </footer>
</div>
{{end}}

{{define "scripts"}}
<script src="/static/js/mapper.js?v={{.Version}}"></script>
<script src="/static/js/app.js?v={{.Version}}"></script>
{{end}}
