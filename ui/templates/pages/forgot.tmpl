{{define "title"}}Reset your password - MPP Viewer{{end}}

{{define "main"}}
<main class="auth centered">
  <h1>Reset your password</h1>

  <p class="lead">Enter the address you signed up with and we will send you a link.</p>

  {{with .Flash}}<p class="flash">{{.}}</p>{{end}}

  <form action="/reset" method="POST" novalidate>
    <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">

    <div class="field">
      <label for="email">Email</label>
      {{with index .Form.FieldErrors "email"}}<span class="field__error">{{.}}</span>{{end}}
      <input id="email" type="email" name="email" value="{{.Form.Email}}" autocomplete="email" autofocus required>
    </div>

    <button class="btn btn--primary" type="submit">Send the link</button>
  </form>

  <div class="auth__foot">
    <p>Remembered it? <a href="/signin">Sign in</a></p>
  </div>

  <p class="legal-line">
    <a href="/privacy">Privacy</a> · <a href="/terms">Terms</a>
  </p>
</main>
{{end}}
