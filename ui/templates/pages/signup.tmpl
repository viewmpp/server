{{define "title"}}Sign up - MPP Viewer{{end}}

{{define "main"}}
<main class="auth centered">
  <h1>Create an account</h1>

  {{with .Flash}}<p class="flash" role="status">{{.}}</p>{{end}}

  {{$emailError := index .Form.FieldErrors "email"}}
  {{$passwordError := index .Form.FieldErrors "password"}}
  <form action="/signup" method="POST" novalidate data-busy>
    <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">

    <div class="field">
      <label for="email">Email</label>
      {{with $emailError}}<span class="field__error" id="email-error" role="alert">{{.}}</span>{{end}}
      <input id="email" type="email" name="email" value="{{.Form.Email}}"
             autocomplete="email" autocapitalize="none" spellcheck="false" required
             {{if $emailError}}aria-invalid="true" aria-describedby="email-error{{if .Form.EmailTaken}} email-taken{{end}}"{{end}}>
      {{if .Form.EmailTaken}}
        <p class="field__hint" id="email-taken"><a href="/signin">Sign in</a> or <a href="/reset">reset your password</a></p>
      {{end}}
    </div>

    <div class="field">
      <label for="password">Password</label>
      {{with $passwordError}}<span class="field__error" id="password-error" role="alert">{{.}}</span>{{end}}
      <input id="password" type="password" name="password" autocomplete="new-password" required
             aria-describedby="{{if $passwordError}}password-error {{end}}password-hint"
             {{if $passwordError}}aria-invalid="true"{{end}}>
      <p class="field__hint" id="password-hint">At least 8 characters.</p>
    </div>

    <button class="btn btn--solid" type="submit">Create account</button>
  </form>

  <div class="auth__foot">
    <p>Already have an account? <a href="/signin">Sign in</a></p>
  </div>
</main>
{{end}}
