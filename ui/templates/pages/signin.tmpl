{{define "title"}}Sign in - MPP Viewer{{end}}

{{define "main"}}
<main class="auth centered">
  <h1>Sign in</h1>

  {{with .Flash}}<p class="flash" role="status">{{.}}</p>{{end}}

  {{$formError := index .Form.FieldErrors "email"}}
  <form action="/signin" method="POST" novalidate data-busy>
    <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">

    {{with $formError}}
      <p class="field__error" id="signin-error" role="alert">{{.}}</p>
    {{end}}

    <div class="field">
      <label for="email">Email</label>
      <input id="email" type="email" name="email" value="{{.Form.Email}}"
             autocomplete="email" autocapitalize="none" spellcheck="false" required
             {{if $formError}}aria-invalid="true" aria-describedby="signin-error"{{end}}>
    </div>

    <div class="field">
      <label for="password">Password</label>
      <input id="password" type="password" name="password" autocomplete="current-password" required
             {{if $formError}}aria-invalid="true" aria-describedby="signin-error"{{end}}>
    </div>

    <button class="btn btn--solid" type="submit">Sign in</button>
  </form>

  <div class="auth__foot">
    <p>No account yet? <a href="/signup">Create one</a></p>
    <p class="auth__alt"><a href="/reset">Forgot your password?</a></p>
  </div>
</main>
{{end}}
