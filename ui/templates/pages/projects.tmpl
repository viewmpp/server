{{define "title"}}Your projects - MPP Viewer{{end}}

{{define "main"}}
<main class="page centered">
  <div class="page__head">
    <h1>Your projects</h1>
    <a class="btn btn--primary btn--inline" href="/">Open a file</a>
  </div>

  {{with .Flash}}<p class="flash">{{.}}</p>{{end}}

  {{if .Form}}
    <ul class="cards">
      {{range .Form}}
        <li class="card">
          <a class="card__name" href="/p/{{.PublicID}}">{{.FileName}}</a>
          <div class="card__meta">
            <time datetime="{{.CreatedAt.Format "2006-01-02"}}">{{.CreatedAt.Format "2 Jan 2006"}}</time>
            <span class="tag tag--{{.Access}}">{{.Access}}</span>
            <form action="/p/{{.PublicID}}/delete" method="POST" data-confirm="Delete {{.FileName}}?">
              <input type="hidden" name="csrf_token" value="{{$.CSRFToken}}">
              <button class="linkish" type="submit">Delete</button>
            </form>
          </div>
        </li>
      {{end}}
    </ul>
  {{else}}
    <div class="drop" id="drop" data-max-upload="{{.MaxUpload}}">
      <input type="file" id="file" accept=".mpp,.xml" hidden>
      <p class="drop__hint">Drop a file here or <label for="file" class="link">pick one from disk</label></p>
      <p class="drop__note">It will be saved to your projects.</p>
      <ul class="drop__terms">
        <li><code>.mpp</code> or <code>.xml</code></li>
        <li>up to {{.MaxUploadLabel}}</li>
      </ul>
    </div>

    <p class="drop__error is-hidden" id="error"></p>
  {{end}}

  <p class="legal-line">
    <a href="/privacy">Privacy</a> · <a href="/terms">Terms</a>
  </p>
</main>
{{end}}

{{define "scripts"}}
<script>
  window.MppUpload.bind({
    drop: document.getElementById('drop'),
    file: document.getElementById('file'),
    onStart: function () { document.getElementById('error').classList.add('is-hidden'); },
    onError: function (message) {
      var box = document.getElementById('error');
      box.textContent = message;
      box.classList.remove('is-hidden');
    },
    onDone: function (contract, file, projectID) {
      window.location.assign(projectID ? '/p/' + projectID : '/projects');
    }
  });
</script>
{{end}}
