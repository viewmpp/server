{{define "viewer"}}
<div class="loading{{if not (or .ProjectID .ExampleName)}} is-hidden{{end}}" id="loading" role="status">
  <span class="loading__spin" aria-hidden="true"></span>
  <span class="loading__text" id="loading-text">{{if .FileName}}Opening {{.FileName}}{{else}}Opening the plan{{end}}</span>
</div>
<div class="app is-hidden" id="app" data-project-id="{{.ProjectID}}" data-example-name="{{.ExampleName}}" data-file-name="{{.FileName}}">
  <header class="bar">
    <div class="bar__row">
      <div class="bar__title">
        <span id="project-name" class="bar__name"></span>
        {{if and .IsOwner (ne .Access "private")}}
          <span class="tag tag--{{.Access}}">{{.Access}}</span>
        {{else if and .IsOwner (not .CanShare)}}
          <span class="tag tag--private">Private</span>
        {{end}}
      </div>

      <div class="bar__sep"></div>

      <div class="searchbox" id="searchbox">
        <input type="search" id="search" class="search" placeholder="Search tasks" autocomplete="off">
        <span class="searchbox__count is-hidden" id="search-count" aria-live="polite"></span>
      </div>

      <div class="zoom">
        <input class="zoom__range" type="range" id="scale-range"
               min="0" max="100" step="1" value="0" aria-label="Time scale">
        <span class="zoom__label" id="scale-label">Day</span>
      </div>

      <div class="menu" data-menu>
        <button class="btn btn--sm" type="button" id="filter-toggle" data-menu-toggle
                aria-haspopup="true" aria-expanded="false">
          <svg class="ico" viewBox="0 0 20 20" aria-hidden="true">
            <path d="M3.5 5h13M6 10h8M8.5 15h3"/>
          </svg>
          <span id="filter-label">Filter</span>
        </button>

        <div class="menu__panel is-hidden" data-menu-panel>
          <button class="menu__item is-active" type="button" data-filter="all">All tasks</button>
          <button class="menu__item" type="button" data-filter="critical">Critical path</button>
          <button class="menu__item" type="button" data-filter="overdue">Overdue</button>
          <button class="menu__item" type="button" data-filter="incomplete">Incomplete</button>
          <button class="menu__item" type="button" data-filter="milestones">Milestones</button>
        </div>
      </div>

      <div class="bar__sep"></div>

      <div class="bar__group bar__group--switches">
        <label class="switch">
          <input type="checkbox" id="toggle-critical" checked>
          <span class="switch__track"></span>
          critical path
        </label>
        <label class="switch">
          <input type="checkbox" id="toggle-overdue">
          <span class="switch__track"></span>
          overdue
        </label>
      </div>

      <div class="bar__spacer"></div>

      <div class="bar__actions">
        {{if .ProjectID}}
          <a class="btn btn--sm" href="/p/{{.ProjectID}}/xlsx">
            <svg class="ico" viewBox="0 0 20 20" aria-hidden="true">
              <path d="M10 3v9M6.5 8.5 10 12l3.5-3.5"/>
              <path d="M3.5 13.5V15A1.5 1.5 0 0 0 5 16.5h10a1.5 1.5 0 0 0 1.5-1.5v-1.5"/>
            </svg>
            Export to Excel
          </a>
        {{else}}
          <button class="btn btn--sm" id="export-xlsx" type="button">
            <svg class="ico" viewBox="0 0 20 20" aria-hidden="true">
              <path d="M10 3v9M6.5 8.5 10 12l3.5-3.5"/>
              <path d="M3.5 13.5V15A1.5 1.5 0 0 0 5 16.5h10a1.5 1.5 0 0 0 1.5-1.5v-1.5"/>
            </svg>
            Export to Excel
          </button>
        {{end}}

        {{if .IsOwner}}
          <div class="menu menu--wide" data-menu>
            <button class="btn btn--sm{{if ne .Access "private"}} is-active{{end}}" type="button" data-menu-toggle
                    aria-haspopup="true" aria-expanded="false">
              <svg class="ico" viewBox="0 0 20 20" aria-hidden="true">
                <path d="M8 11a3 3 0 0 0 4.24 0l2.5-2.5a3 3 0 1 0-4.24-4.24l-.7.7"/>
                <path d="M12 9a3 3 0 0 0-4.24 0l-2.5 2.5a3 3 0 1 0 4.24 4.24l.7-.7"/>
              </svg>
              {{if eq .Access "private"}}Share{{else}}Shared{{end}}
            </button>

            <div class="menu__panel share is-hidden" data-menu-panel>
              <p class="share__title">
                {{if eq .Access "private"}}Create a link to this plan{{else if eq .Access "protected"}}Anyone with the link and password can open it{{else}}Anyone with the link can open it{{end}}
              </p>

              {{if ne .Access "private"}}
                <div class="share__link">
                  <input class="share__url" type="text" readonly value="/p/{{.ProjectID}}" data-share-url aria-label="Share link">
                  <button class="btn btn--sm" type="button" id="copy-link" data-link="/p/{{.ProjectID}}"><span data-label>Copy</span></button>
                </div>
              {{end}}

              {{if and (eq .Access "private") (not .CanShare)}}
                <p class="share__note">
                  {{if not .Verified}}
                    <form action="/verify/resend" method="POST" class="share__inline" data-cooldown="{{.ResendSeconds}}">
                      <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
                      <button class="linkish" type="submit">Confirm your email address</button>
                    </form>
                    to share a link.
                  {{else}}
                    Free accounts share {{.MaxPublicFree}} plans at a time. <a href="/projects">Stop sharing one</a>, or go Pro.
                  {{end}}
                </p>
              {{else}}
                <form action="/p/{{.ProjectID}}/access" method="POST" class="share__form" data-share-form data-share-current="{{.Access}}">
                  <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
                  <input type="hidden" name="access" value="{{if eq .Access "protected"}}protected{{else}}public{{end}}" data-share-access>

                  {{if .CanProtect}}
                    <label class="switch">
                      <input type="checkbox" data-share-protect {{if eq .Access "protected"}}checked{{end}}>
                      <span class="switch__track"></span>
                      Require a password
                    </label>

                    <div class="share__pass{{if ne .Access "protected"}} is-collapsed{{end}}" data-share-pass>
                      <div class="share__pass__inner">
                        {{if eq .Access "protected"}}
                          <div class="item item--muted">
                            <div class="item__content">
                              <span class="item__title">Password set</span>
                              <span class="item__desc">Anyone opening the link must enter it</span>
                            </div>
                            <div class="item__actions">
                              <button class="btn btn--sm btn--ghost" type="button" data-share-change>Change</button>
                            </div>
                          </div>
                        {{end}}

                        <div class="share__edit{{if eq .Access "protected"}} is-collapsed{{end}}" data-share-edit>
                          <div class="share__pass__inner">
                            <input class="share__input" type="password" name="password"
                                   placeholder="{{if eq .Access "protected"}}New password{{else}}Password{{end}}"
                                   aria-label="{{if eq .Access "protected"}}New link password{{else}}Link password{{end}}"
                                   autocomplete="new-password"
                                   minlength="{{.MinPasswordLength}}"
                                   maxlength="{{.MaxPasswordLength}}">
                            <p class="share__hint">At least {{.MinPasswordLength}} characters.</p>

                            {{if eq .Access "protected"}}
                              <button class="btn btn--sm btn--ghost btn--inline" type="button" data-share-cancel>
                                Cancel
                              </button>
                            {{end}}
                          </div>
                        </div>
                      </div>
                    </div>
                  {{else}}
                    <p class="share__hint">
                      Need a password on this link? <a href="/pricing">Pro adds that</a>. Public links stay free.
                    </p>
                  {{end}}


                  <button class="btn btn--sm btn--primary btn--inline" type="submit" data-share-submit>
                    {{if eq .Access "private"}}Create link{{else}}Save changes{{end}}
                  </button>
                </form>
              {{end}}

              {{if ne .Access "private"}}
                <div class="menu__sep"></div>
                <form action="/p/{{.ProjectID}}/access" method="POST">
                  <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
                  <input type="hidden" name="access" value="private">
                  <button class="menu__item menu__item--danger" type="submit">Stop sharing</button>
                </form>
              {{end}}
            </div>
          </div>
        {{end}}

        <button class="btn btn--sm" id="reset" type="button">Another file</button>

        {{if .IsOwner}}
          <div class="menu" data-menu>
            <button class="btn btn--sm btn--icon" type="button" data-menu-toggle
                    aria-haspopup="true" aria-expanded="false" aria-label="More actions" title="More actions">
              <svg class="ico" viewBox="0 0 20 20" aria-hidden="true">
                <circle cx="4.5" cy="10" r="1.2" fill="currentColor" stroke="none"/>
                <circle cx="10" cy="10" r="1.2" fill="currentColor" stroke="none"/>
                <circle cx="15.5" cy="10" r="1.2" fill="currentColor" stroke="none"/>
              </svg>
            </button>

            <div class="menu__panel is-hidden" data-menu-panel>
              <form action="/p/{{.ProjectID}}/delete" method="POST" data-confirm="Delete this project?">
                <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
                <button class="menu__item menu__item--danger" type="submit">Delete plan</button>
              </form>
            </div>
          </div>
        {{end}}
      </div>
    </div>
  </header>

  <div class="summary is-hidden" id="summary"></div>

  <div class="workspace">
    <div id="gantt-here"></div>

    <div class="sizer" id="sizer">
      <input class="sizer__range" type="range" id="size-range"
             min="60" max="100" step="1" value="100" aria-label="Chart size">
      <span class="sizer__label" id="size-label">100%</span>
    </div>

    {{with .Flash}}
      <div class="toast toast--flash" id="viewer-flash">
        <span class="toast__text">{{.}}</span>
        <button class="toast__close" type="button" data-toast-close aria-label="Dismiss">&times;</button>
      </div>
    {{end}}

    <aside id="details" class="details is-hidden">
      <button class="details__close" id="details-close" aria-label="Close">&times;</button>
      <div id="details-body"></div>
    </aside>

    {{if and .ProjectID (not .IsOwner)}}
      <div class="toast is-hidden" id="send-cta">
        <span class="offer__text">Send plans yourself? Colleagues can read them without MS Project.</span>
        <a class="btn btn--sm btn--primary btn--inline" href="/share-a-project-plan">How sharing works</a>
        <button class="toast__close" type="button" id="send-cta-close" aria-label="Dismiss">&times;</button>
      </div>
    {{end}}

    {{if and (not .ProjectID) (not .ExampleName)}}
      <div class="toast is-hidden" id="save-cta" data-signed-in="{{if .UserEmail}}1{{else}}0{{end}}">
        <span class="offer__text" id="save-cta-text"></span>
        <a class="btn btn--sm btn--primary btn--inline is-hidden" id="save-cta-signup" href="/signup" target="_blank" rel="noopener">Create a free account</a>
        <button class="btn btn--sm btn--primary btn--inline is-hidden" id="save-cta-save" type="button">Save this plan</button>
        <a class="btn btn--sm is-hidden" id="save-cta-manage" href="/projects">Manage plans</a>
        <button class="toast__close" type="button" id="save-cta-close" aria-label="Dismiss">&times;</button>
      </div>
    {{end}}
  </div>

  <footer class="statusbar">
    <span id="stats">-</span>
    <span class="legend">
      <span class="legend__item is-hidden" id="legend-today"><i class="sw sw--today"></i> today</span>
      <span class="legend__item" id="legend-critical"><i class="sw sw--crit"></i> critical task</span>
      <span class="legend__item is-hidden" id="legend-overdue"><i class="sw sw--overdue"></i> overdue</span>
      <span class="legend__item"><i class="sw sw--off"></i> non-working day</span>
    </span>
  </footer>
</div>
{{end}}
