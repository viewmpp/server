{{define "base"}}<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="description" content="Open an MS Project (.mpp) file in your browser and see the Gantt chart straight away — no install, no signup.">
<title>{{template "title" .}}</title>
<link rel="stylesheet" href="/static/css/app.css?v={{.Version}}">
{{block "head" .}}{{end}}
</head>
<body>
<aside class="side">
  <a class="side__brand" href="/">MPP&nbsp;Viewer</a>

  <nav class="side__nav">
    <a href="/">Open a file</a>
    {{if .UserEmail}}<a href="/projects">Projects</a>{{end}}
  </nav>

  <div class="side__foot">
    {{if .UserEmail}}
      <div class="side__user" title="{{.UserEmail}}">{{.UserEmail}}</div>
      {{if not .Verified}}<a class="side__warn" href="/verify">confirm email</a>{{end}}
      <form action="/logout" method="POST">
        <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
        <button class="linkish" type="submit">Sign out</button>
      </form>
    {{else}}
      <a href="/login">Sign in</a>
      <a href="/signup">Sign up</a>
    {{end}}
  </div>
</aside>

<div class="main">
{{template "main" .}}
</div>
{{block "scripts" .}}{{end}}
</body>
</html>
{{end}}
