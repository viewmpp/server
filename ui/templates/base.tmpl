{{define "base"}}<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
{{if .Description}}<meta name="description" content="{{.Description}}">{{else}}<meta name="description" content="Open an MS Project (.mpp) file in your browser and see the Gantt chart straight away - no install, no signup.">{{end}}
{{if .NoIndex}}<meta name="robots" content="noindex">
{{end}}{{if .Canonical}}<link rel="canonical" href="{{.Canonical}}">
{{end}}<title>{{if .Title}}{{.Title}}{{else}}{{template "title" .}}{{end}}</title>
{{if .Description}}<meta property="og:type" content="website">
<meta property="og:site_name" content="MPP Viewer">
<meta property="og:title" content="{{if .Title}}{{.Title}}{{else}}{{template "title" .}}{{end}}">
<meta property="og:description" content="{{.Description}}">
{{if .Canonical}}<meta property="og:url" content="{{.Canonical}}">
{{end}}<meta name="twitter:card" content="summary">
{{end}}
<script>
(function(){try{var m=localStorage.getItem('mpp-theme');
if(m!=='light'&&m!=='dark'){m=matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light';}
var r=document.documentElement;r.setAttribute('data-theme',m);
r.setAttribute('data-gantt-theme',m==='dark'?'dark':'terrace');}catch(e){}})();
</script>
<link rel="stylesheet" href="/static/css/app.css?v={{.Version}}">
{{block "head" .}}{{end}}
</head>
<body>
<aside class="side">
  <a class="side__brand" href="/">MPP&nbsp;Viewer</a>

  <nav class="side__nav">
    <a href="/">
      <svg class="ico" viewBox="0 0 20 20" aria-hidden="true">
        <path d="M11 2.5H5.5A1.5 1.5 0 0 0 4 4v12a1.5 1.5 0 0 0 1.5 1.5h9A1.5 1.5 0 0 0 16 16V7.5L11 2.5Z"/>
        <path d="M11 2.5V7a.5.5 0 0 0 .5.5H16"/>
        <path d="M10 14v-4.5M8 11.5 10 9.5l2 2"/>
      </svg>
      Open a file
    </a>
    <a href="/examples">
      <svg class="ico" viewBox="0 0 20 20" aria-hidden="true">
        <path d="M3 15.5V5a1.5 1.5 0 0 1 1.5-1.5h11A1.5 1.5 0 0 1 17 5v10.5"/>
        <path d="M3 15.5h14"/>
        <path d="M6.5 12.5v-3M10 12.5v-6M13.5 12.5v-4"/>
      </svg>
      Examples
    </a>
    {{if .UserEmail}}
      <a href="/projects">
        <svg class="ico" viewBox="0 0 20 20" aria-hidden="true">
          <path d="M2.5 5.5A1.5 1.5 0 0 1 4 4h3.2a1 1 0 0 1 .8.4l1 1.35a1 1 0 0 0 .8.4H16a1.5 1.5 0 0 1 1.5 1.5V15a1.5 1.5 0 0 1-1.5 1.5H4A1.5 1.5 0 0 1 2.5 15v-9.5Z"/>
        </svg>
        Projects
      </a>
    {{end}}
  </nav>

  <div class="side__foot">
    {{if .UserEmail}}
      <div class="side__account">
        <div class="side__id">
          <span class="side__avatar" aria-hidden="true">
            <svg viewBox="0 0 20 20">
              <circle cx="10" cy="7" r="3"/>
              <path d="M4 16.5c0-2.5 2.7-4 6-4s6 1.5 6 4"/>
            </svg>
          </span>
          <span class="side__user side__mail" title="{{.UserEmail}}">{{.UserEmail}}</span>
        </div>

        {{if not .Verified}}
          <a class="side__warn" href="/verify">Email not confirmed</a>
        {{else if .Pro}}
          <span class="side__plan">Pro</span>
        {{else}}
          <form action="/subscribe" method="POST">
            <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
            <button class="side__upgrade linkish" type="submit">Get Pro - free for early users</button>
          </form>
        {{end}}

        <form action="/signout" method="POST">
          <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
          <button class="side__out linkish" type="submit">Sign out</button>
        </form>
      </div>
    {{else}}
      <div class="side__cta">
        <a class="btn btn--primary" href="/signup">Create free account</a>
        <a class="side__signin" href="/signin">Sign in</a>
      </div>
    {{end}}

    <div class="theme" role="group" aria-label="Colour theme">
      <button class="theme__btn" type="button" data-theme-set="light" aria-pressed="false">Light</button>
      <button class="theme__btn" type="button" data-theme-set="dark" aria-pressed="false">Dark</button>
      <button class="theme__btn" type="button" data-theme-set="system" aria-pressed="false">System</button>
    </div>
  </div>
</aside>

<div class="main">
{{template "main" .}}
</div>
<script src="/static/js/theme.js?v={{.Version}}"></script>
<script src="/static/js/common.js?v={{.Version}}"></script>
{{block "scripts" .}}{{end}}
</body>
</html>
{{end}}
