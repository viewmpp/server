{{define "base"}}<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
{{if .Description}}<meta name="description" content="{{.Description}}">{{else}}<meta name="description" content="Open an MS Project (.mpp) file in your browser and see the Gantt chart straight away - no install, no signup.">{{end}}
{{with .Robots}}<meta name="robots" content="{{.}}">
{{end}}{{if .Canonical}}<link rel="canonical" href="{{.Canonical}}">
{{end}}<title>{{if .Title}}{{.Title}}{{else}}{{template "title" .}}{{end}}</title>
{{if .Description}}<meta property="og:type" content="website">
<meta property="og:site_name" content="MPP Viewer">
<meta property="og:title" content="{{if .Title}}{{.Title}}{{else}}{{template "title" .}}{{end}}">
<meta property="og:description" content="{{.Description}}">
{{if .Canonical}}<meta property="og:url" content="{{.Canonical}}">
{{end}}{{with .OGImage}}<meta property="og:image" content="{{.}}">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
{{end}}<meta name="twitter:card" content="summary_large_image">
{{end}}
<script>
(function(){try{var m=localStorage.getItem('mpp-theme');
if(m!=='light'&&m!=='dark'){m=matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light';}
var r=document.documentElement;r.setAttribute('data-theme',m);
r.setAttribute('data-gantt-theme',m==='dark'?'dark':'terrace');}catch(e){}})();
</script>
<link rel="icon" href="/static/icons/favicon.ico?v={{.Version}}" sizes="any">
<link rel="icon" type="image/png" href="/static/icons/icon-192.png?v={{.Version}}">
<link rel="apple-touch-icon" href="/static/icons/apple-touch-icon.png?v={{.Version}}">
<link rel="stylesheet" href="/static/css/app.css?v={{.Version}}">
{{block "head" .}}{{end}}
</head>
<body>
<aside class="side">
  <a class="side__brand" href="/">MPP&nbsp;Viewer</a>

  <nav class="side__nav">
    <a href="/">
      <svg class="ico" viewBox="0 0 20 20" aria-hidden="true">
        <path d="M11 2.5H5.5A1.5 1.5 0 0 0 4 4v12a1.5 1.5 0 0 0 1.5 1.5h9A1.5 1.5 0 0 0 16 16V7.5L11 2.5Z"/>
        <path d="M11 2.5V7a.5.5 0 0 0 .5.5H16"/>
        <path d="M10 14v-4.5M8 11.5 10 9.5l2 2"/>
      </svg>
      Open a file
    </a>
    <a href="/examples">
      <svg class="ico" viewBox="0 0 20 20" aria-hidden="true">
        <path d="M3 15.5V5a1.5 1.5 0 0 1 1.5-1.5h11A1.5 1.5 0 0 1 17 5v10.5"/>
        <path d="M3 15.5h14"/>
        <path d="M6.5 12.5v-3M10 12.5v-6M13.5 12.5v-4"/>
      </svg>
      Examples
    </a>
    {{if .UserEmail}}
      <a href="/projects">
        <svg class="ico" viewBox="0 0 20 20" aria-hidden="true">
          <path d="M2.5 5.5A1.5 1.5 0 0 1 4 4h3.2a1 1 0 0 1 .8.4l1 1.35a1 1 0 0 0 .8.4H16a1.5 1.5 0 0 1 1.5 1.5V15a1.5 1.5 0 0 1-1.5 1.5H4A1.5 1.5 0 0 1 2.5 15v-9.5Z"/>
        </svg>
        Projects
      </a>
    {{end}}
  </nav>

  <div class="side__foot">
    {{if .UserEmail}}
      <div class="menu menu--up" data-menu>
        <button class="account" type="button" data-menu-toggle
                aria-haspopup="true" aria-expanded="false" title="{{.UserEmail}}">
          <span class="account__avatar" aria-hidden="true">
            <svg viewBox="0 0 20 20">
              <circle cx="10" cy="7" r="3"/>
              <path d="M4 16.5c0-2.5 2.7-4 6-4s6 1.5 6 4"/>
            </svg>
          </span>
          <span class="account__id">
            <span class="account__mail">{{.UserEmail}}</span>
            <span class="account__plan{{if or (not .Verified) .ProWarning}} account__plan--warn{{end}}">
              {{if not .Verified}}Email not confirmed
              {{else if .Pro}}Pro{{with .ProWarning}} - {{.}}{{end}}
              {{else}}Free{{end}}
            </span>
          </span>
          <svg class="ico account__chev" viewBox="0 0 20 20" aria-hidden="true">
            <path d="M7 8.5 10 5.5l3 3"/>
            <path d="M7 11.5 10 14.5l3-3"/>
          </svg>
        </button>

        <div class="menu__panel is-hidden" data-menu-panel>
          {{if not .Verified}}
            <a class="menu__item menu__item--warn" href="/verify">Confirm your email</a>
            <div class="menu__sep"></div>
          {{else if not .Pro}}
            <form action="/subscribe" method="POST">
              <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
              <button class="menu__item menu__item--pro" type="submit">Get Pro - free for early users</button>
            </form>
            <div class="menu__sep"></div>
          {{end}}

          <a class="menu__item" href="/account">Account</a>

          <form action="/signout" method="POST">
            <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
            <button class="menu__item" type="submit">Sign out</button>
          </form>
        </div>
      </div>
    {{else}}
      <div class="side__cta">
        <a class="btn btn--primary" href="/signup">Create free account</a>
        <a class="side__signin" href="/signin">Sign in</a>
      </div>
    {{end}}

    <div class="theme" role="group" aria-label="Colour theme">
      <button class="theme__btn" type="button" data-theme-set="light" aria-pressed="false" aria-label="Light" title="Light">
        <svg class="ico" viewBox="0 0 20 20" aria-hidden="true">
          <circle cx="10" cy="10" r="3.4"/>
          <path d="M10 2.6v1.6M10 15.8v1.6M2.6 10h1.6M15.8 10h1.6M4.8 4.8l1.1 1.1M14.1 14.1l1.1 1.1M15.2 4.8l-1.1 1.1M5.9 14.1l-1.1 1.1"/>
        </svg>
      </button>
      <button class="theme__btn" type="button" data-theme-set="dark" aria-pressed="false" aria-label="Dark" title="Dark">
        <svg class="ico" viewBox="0 0 20 20" aria-hidden="true">
          <path d="M16.5 11.3A6.9 6.9 0 0 1 8.7 3.5a6.9 6.9 0 1 0 7.8 7.8Z"/>
        </svg>
      </button>
      <button class="theme__btn" type="button" data-theme-set="system" aria-pressed="false" aria-label="System" title="System">
        <svg class="ico" viewBox="0 0 20 20" aria-hidden="true">
          <rect x="2.8" y="4" width="14.4" height="9.5" rx="1.5"/>
          <path d="M7 16.5h6"/>
        </svg>
      </button>
    </div>
  </div>
</aside>

<div class="main">
{{template "main" .}}
</div>
<script src="/static/js/theme.js?v={{.Version}}"></script>
<script src="/static/js/common.js?v={{.Version}}"></script>
{{block "scripts" .}}{{end}}
</body>
</html>
{{end}}
